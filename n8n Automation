    {
      "parameters": {
        "jsCode": "// ============================================================\n// NODE: Prepare Doc Archive Update\n// ============================================================\n\nconst topicsToArchive = $('Collect Written Posts').first().json.topicsToArchive || [];\n\nconst docItem = $('Read Approval Google Doc').first().json;\nlet docText = '';\nif (typeof docItem.content === 'string') {\n  docText = docItem.content;\n} else if (docItem.body && docItem.body.content) {\n  docText = docItem.body.content\n    .filter(b => b.paragraph)\n    .map(b => (b.paragraph.elements || []).map(el => el.textRun ? el.textRun.content : '').join(''))\n    .join('');\n} else {\n  throw new Error('Cannot read doc. Keys: ' + Object.keys(docItem).join(', '));\n}\n\ndocText = docText.replace(/\\\\n/g, '\\n').replace(/\\r\\n/g, '\\n').replace(/\\r/g, '\\n');\n\nif (!topicsToArchive || topicsToArchive.length === 0) {\n  return [{ json: { newDocText: docText, archivedCount: 0, keptCount: 0, skipped: true } }];\n}\n\nfunction splitIntoSections(text) {\n  const result = {};\n  const lines = text.split('\\n');\n  let currentSection = '_preamble';\n  result[currentSection] = [];\n  lines.forEach(line => {\n    if (line.match(/^##\\s+[^#]/)) {\n      currentSection = line.replace(/^##\\s+/, '').trim();\n      result[currentSection] = [];\n    } else {\n      result[currentSection].push(line);\n    }\n  });\n  return result;\n}\n\nconst sections = splitIntoSections(docText);\nconst approvedKey = Object.keys(sections).find(k => k.toLowerCase().includes('approved'));\nconst movedKey    = Object.keys(sections).find(k => k.toLowerCase().includes('moved')) || 'Moved to Sheet';\n\nif (!approvedKey) {\n  return [{ json: { newDocText: docText, archivedCount: 0, keptCount: 0 } }];\n}\n\nconst approvedText = sections[approvedKey].join('\\n');\nconst dividerPattern = /\\n[\\s\\u2013\\u2014\\u2015\\u2500\\-_=*]{3,}\\s*\\n/g;\nlet allApprovedPosts = approvedText.split(dividerPattern).map(b => b.trim()).filter(b => b.length > 10);\n\nif (allApprovedPosts.length <= 1) {\n  allApprovedPosts = approvedText.split(/\\n{3,}/).map(b => b.trim()).filter(b => b.length > 10);\n}\n\nconst postsToMove = [];\nconst postsToKeep = [];\n\nallApprovedPosts.forEach(postBlock => {\n  const firstLine = postBlock.split('\\n')[0].replace(/^#+\\s+/, '').trim().toLowerCase();\n  const shouldMove = topicsToArchive.some(t =>\n    firstLine.includes(t.toLowerCase()) || t.toLowerCase().includes(firstLine)\n  );\n  if (shouldMove) postsToMove.push(postBlock.trim());\n  else postsToKeep.push(postBlock.trim());\n});\n\nconst movedTimestamp  = new Date().toISOString().split('T')[0];\nconst existingMoved   = sections[movedKey] ? sections[movedKey].join('\\n').trim() : '';\nconst newMovedContent = [existingMoved, postsToMove.length > 0 ? `\\n\\n— Moved on ${movedTimestamp} —` : '', ...postsToMove].join('\\n').trim();\nconst preamble        = sections['_preamble'] ? sections['_preamble'].join('\\n').trim() : '';\n\nlet newDocText = '';\nif (preamble) newDocText += preamble + '\\n\\n';\nnewDocText += `## ${approvedKey}\\n\\n`;\nnewDocText += postsToKeep.length > 0 ? postsToKeep.join('\\n\\n---\\n\\n') : '(No pending posts)';\nnewDocText += `\\n\\n## ${movedKey}\\n\\n` + newMovedContent;\n\nObject.keys(sections).forEach(key => {\n  if (['_preamble', approvedKey, movedKey].includes(key)) return;\n  newDocText += `\\n\\n## ${key}\\n\\n${sections[key].join('\\n').trim()}`;\n});\n\nreturn [{ json: { newDocText, archivedCount: postsToMove.length, keptCount: postsToKeep.length } }];"
      },
