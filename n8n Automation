    {
      "parameters": {
        "jsCode": "// ============================================================\n// NODE: Parse Gemini Response + Assign Posting Dates\n// ============================================================\n\nconst geminiResponse = $('Gemini — Analyze & Order Posts').first().json;\nconst pendingPosts   = $('Build Gemini Prompt').first().json.pendingPosts;\n\nlet rawText = '';\ntry {\n  rawText = geminiResponse.candidates[0].content.parts[0].text;\n} catch (e) {\n  throw new Error('Gemini response structure unexpected: ' + JSON.stringify(geminiResponse));\n}\n\nconst cleaned = rawText\n  .replace(/^```json\\s*/i, '')\n  .replace(/^```\\s*/i, '')\n  .replace(/\\s*```$/i, '')\n  .trim();\n\nlet orderedPosts;\ntry {\n  orderedPosts = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('Failed to parse Gemini JSON. Raw: ' + rawText.slice(0, 500));\n}\n\nif (!Array.isArray(orderedPosts) || orderedPosts.length === 0) {\n  throw new Error('Gemini returned empty or non-array output.');\n}\n\nfunction getNextTuesday(fromDate, weeksAhead) {\n  const d = new Date(fromDate);\n  const dayOfWeek = d.getDay();\n  const daysUntilTuesday = (2 - dayOfWeek + 7) % 7 || 7;\n  d.setDate(d.getDate() + daysUntilTuesday + (weeksAhead * 7));\n  return d;\n}\n\nconst today = new Date();\nconst dayNames = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];\n\nconst sheetRows = orderedPosts.map((item, weekIndex) => {\n  const pendingPost = pendingPosts[item.originalIndex];\n  if (!pendingPost) throw new Error(`Invalid originalIndex: ${item.originalIndex}`);\n\n  const postDate = getNextTuesday(today, weekIndex);\n  const dateStr  = postDate.toISOString().split('T')[0];\n  const dayName  = dayNames[postDate.getDay()];\n\n  return {\n    json: {\n      Date:            dateStr,\n      Day:             dayName,\n      'Post Campaign': item.campaign,\n      'Post Topic':    pendingPost.topic,\n      'Post Content':  pendingPost.content,\n      Comment:         item.schedulingReason || '',\n      Media:           '',\n      Status:          'Scheduled',\n      _originalTopic:  pendingPost.topic,\n      _weekIndex:      weekIndex,\n    }\n  };\n});\n\nconsole.log(`Assigned ${sheetRows.length} posts starting from next Tuesday.`);\nreturn sheetRows;"
      },
