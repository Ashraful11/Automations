      "parameters": {
        "jsCode": "// ============================================================\n// NODE: Build Gemini Prompt\n// ============================================================\n// Customize the company name and platform below.\n// ============================================================\n\nconst COMPANY_NAME = 'Your Company Name';       // ← change this\nconst PLATFORM = 'LinkedIn';                    // ← change this\n\nconst pendingPosts = $('Parse Approved Posts from Doc').first().json.pendingPosts;\n\nlet historyRows = [];\ntry {\n  const items = $('Read Scheduled Posts History').all();\n  if (items && items.length > 0) {\n    historyRows = items.map(item => item.json).filter(Boolean);\n  }\n} catch(e) {\n  historyRows = [];\n}\n\nconst eightWeeksAgo = new Date();\neightWeeksAgo.setDate(eightWeeksAgo.getDate() - 56);\n\nconst recentHistory = historyRows\n  .filter(row => {\n    if (!row.Date) return false;\n    const d = new Date(row.Date);\n    return !isNaN(d.getTime()) && d >= eightWeeksAgo;\n  })\n  .map(row => ({\n    date:     row.Date              || '',\n    campaign: row['Post Campaign']  || '',\n    topic:    row['Post Topic']     || '',\n    status:   row.Status            || ''\n  }));\n\nconst allScheduledTopics = historyRows\n  .map(row => (row['Post Topic'] || '').toLowerCase().trim())\n  .filter(Boolean);\n\nconst prompt = `You are a ${PLATFORM} content strategist for ${COMPANY_NAME}.\n\nYour task:\n1. Analyze recently scheduled posts for content themes and flow\n2. Review all pending posts\n3. Decide the BEST ORDER to schedule pending posts across future weeks\n4. Assign a short campaign label to each post\n5. Ensure no topic repetition and maintain logical content variety\n\n---\n## RECENTLY SCHEDULED POSTS (last 8 weeks)\n${recentHistory.length > 0 ? JSON.stringify(recentHistory, null, 2) : 'No history yet.'}\n\n## ALL TOPICS EVER SCHEDULED (never repeat)\n${allScheduledTopics.length > 0 ? allScheduledTopics.map(t => '- ' + t).join('\\n') : 'None yet.'}\n\n---\n## PENDING POSTS TO SCHEDULE (${pendingPosts.length} total)\n${JSON.stringify(pendingPosts.map((p, i) => ({ index: i, topic: p.topic, contentPreview: p.content.slice(0, 300) })), null, 2)}\n\n---\n## YOUR TASK\nReturn ONLY a valid JSON array (no markdown, no explanation) with ALL ${pendingPosts.length} posts.\n\nEach item must have exactly:\n{\n  \"originalIndex\": <number>,\n  \"topic\": \"<post topic>\",\n  \"campaign\": \"<2-5 word campaign label>\",\n  \"schedulingReason\": \"<one sentence why this order makes sense>\"\n}\n\nRules:\n- Include ALL pending posts\n- Order for best content variety\n- Avoid similar themes in consecutive weeks\n- Output must be valid JSON only\n`;\n\nreturn [{ json: { prompt, pendingPosts, allScheduledTopics } }];"
      },
