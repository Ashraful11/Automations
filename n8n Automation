      "parameters": {
        "jsCode": "// ============================================================\n// NODE: Parse Approved Posts from Doc\n// ============================================================\n// YOUR DOC STRUCTURE (inside the '## Approved Posts' section):\n//   Post Topic Here          ← first line = title\n//\n//   Post content goes here...\n//   Multiple lines are fine.\n//   ─────────────────────────  ← horizontal rule separator\n//   Another Post Topic\n//\n//   More content here...\n// ============================================================\n\nconst docItem = $('Read Approval Google Doc').first().json;\n\nlet docText = '';\nif (typeof docItem.content === 'string') {\n  docText = docItem.content;\n} else if (docItem.body && docItem.body.content) {\n  docText = docItem.body.content\n    .filter(b => b.paragraph)\n    .map(b => (b.paragraph.elements || []).map(el => el.textRun ? el.textRun.content : '').join(''))\n    .join('');\n} else {\n  throw new Error('Cannot read doc. Keys found: ' + Object.keys(docItem).join(', '));\n}\n\nif (!docText.trim()) throw new Error('Google Doc appears to be empty.');\n\nconst normalizedText = docText\n  .replace(/\\\\n/g, '\\n')\n  .replace(/\\r\\n/g, '\\n')\n  .replace(/\\r/g, '\\n');\n\nconst dividerPattern = /^[\\s\\u2013\\u2014\\u2015\\u2500\\-_=*]{3,}\\s*$/m;\nlet postBlocks = normalizedText.split(dividerPattern).map(b => b.trim()).filter(b => b.length > 0);\n\nif (postBlocks.length <= 1) {\n  postBlocks = normalizedText.split(/\\n{3,}/).map(b => b.trim()).filter(b => b.length > 0);\n}\n\nconst pendingPosts = postBlocks.map(block => {\n  const lines = block.split('\\n').map(l => l.trim()).filter(l => l.length > 0);\n  if (lines.length === 0) return null;\n  const topic = lines[0].trim();\n  const content = lines.slice(1).join('\\n').trim();\n  return { topic, content };\n}).filter(p => p !== null && p.topic && p.content && p.content.length > 10);\n\nif (pendingPosts.length === 0) {\n  const preview = normalizedText.slice(0, 500);\n  throw new Error(`Could not parse any posts.\\nDoc preview:\\n${preview}\\n\\nMake sure posts are separated by horizontal rules (Insert → Horizontal line).`);\n}\n\nconsole.log(`✅ Parsed ${pendingPosts.length} pending post(s)`);\nreturn [{ json: { pendingPosts, count: pendingPosts.length } }];"
      },
